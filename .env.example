# Netlify serverless proxy — optional constraints
# Restrict the Deezer proxy CORS origin (leave empty for "*", e.g. your deployed frontend)
ALLOWED_ORIGIN=

# Frontend — base URL of the Edge Function proxy (defaults to the local path)
VITE_DEEZER_PROXY_BASE=/deezer-proxy

# Future: Deezer OAuth app for playlist sync
DEEZER_APP_ID=
DEEZER_APP_SECRET=